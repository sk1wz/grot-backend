generator client {
  provider     = "prisma-client"
  output       = "./__generated__"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  role     UserRole @default(REGULAR)
  balance  Decimal  @default(0) @db.Decimal(12, 2)

  picture   String?
  method    AuthMethod
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt() @map("updated_at")

  checks              Check[]
  batches             BatchCheck[]
  balanceTransactions BalanceTransaction[]

  @@map("users")
}

model CheckPrice {
  module      CheckModuleEnums @id
  title       String           @default("")
  description String           @default("")
  price       Int
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("check_prices")
}

model Check {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId         String?            @map("batch_id")
  batch           BatchCheck?        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchPosition   Int?               @map("batch_position")
  sourceRow       Int?               @map("source_row")
  serviceId       String?            @map("service_id")
  provider        CheckProviderEnums @default(STORMFINDER)
  module          CheckModuleEnums
  status          CheckStatusEnums   @default(PENDING)
  cost            Int
  balanceRefund   Boolean            @default(false) @map("balance_refund")
  subjectBody     Json
  subjectBodyText String
  result          Json?
  error           Json?
  idempotencyKey  String             @unique @map("idempotency_key")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt() @map("updated_at")
  completedAt     DateTime?          @map("completed_at")

  @@index([userId, createdAt])
  @@index([status])
  @@index([batchId, batchPosition])
  @@map("checks")
}

model BatchCheck {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          CheckModuleEnums
  status          CheckStatusEnums @default(PENDING)
  totalItems      Int              @map("total_items")
  successfulItems Int              @default(0) @map("successful_items")
  failedItems     Int              @default(0) @map("failed_items")
  cost            Int
  currentChunk    Int              @default(0) @map("current_chunk")
  reportPath      String?          @map("report_path")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  completedAt     DateTime?        @map("completed_at")
  checks          Check[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("batch_checks")
}

model BalanceTransaction {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal            @db.Decimal(12, 2)
  status    BalanceStatusEnums
  meta      Json?
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("balance_transactions")
}

model Token {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  @@map("tokens")
}

enum UserRole {
  REGULAR
  ADMIN
}

enum AuthMethod {
  CREDENTIALS
}

enum TokenType {
  PASSWORD_RESET
}

enum CheckModuleEnums {
  GIBDD
  LIMITATION
  GISTORGI
  FSSP
  BANKRUPTCY
  INN
  TAXI
}

enum CheckStatusEnums {
  PENDING
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum CheckProviderEnums {
  STORMFINDER
  DUCKDNS
}

enum BalanceStatusEnums {
  BALANCE_PURCHASE
  BALANCE_REFUND
  BALANCE_TOPUP
  BALANCE_FAILED
}
